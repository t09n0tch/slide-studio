{
  "name": "slide-studio",
  "productName": "Slide Studio",
  "version": "0.11.0",
  "private": true,
  "description": "Local lecture slides with shared API learning notes and optional Clova transcripts.",
  "license": "MIT",
  "author": "Jangwon Son",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/t09n0tch/slide-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/t09n0tch/slide-studio.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.cjs tests/desktop.test.cjs tests/ai.test.cjs tests/transcript.test.cjs tests/audio.test.cjs tests/service-server.test.cjs tests/service-client.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "test:assistant": "node tests/assistant-smoke.cjs",
    "test:transcript": "node tests/transcript-smoke.cjs",
    "test:editing": "node tests/editing-smoke.cjs",
    "test:usability": "node tests/usability-smoke.cjs",
    "test:packaged": "node tests/desktop-smoke.cjs --packaged",
    "build:editor": "node dev/build-editor.mjs",
    "build:audio": "node dev/build-audio.mjs",
    "predist": "node dev/prepare-desktop.mjs",
    "prepack": "node dev/prepare-desktop.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "verify:assets": "node dev/verify-assets.cjs",
    "verify:package": "node dev/verify-package.cjs",
    "checksums": "node dev/checksums.cjs",
    "test:regions": "node tests/regions-smoke.cjs",
    "server:start": "node --env-file-if-exists=server/.env server/index.cjs",
    "server:admin": "node --env-file-if-exists=server/.env server/admin.cjs"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@electron/asar": "4.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
