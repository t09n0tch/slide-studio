# Operator-only settings. Never put these values in the desktop app.
OPENAI_API_KEY=
# An image-input model supporting the Responses API and Structured Outputs.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=12000
# Set the dedicated OpenAI project's enforced monthly spend limit to USD 30 in Platform settings.
# These page limits are separate from the OpenAI billing limit. Zero disables new requests.
STUDIO_DAILY_PAGES=0
STUDIO_MONTHLY_PAGES=0
STUDIO_CONCURRENT=2
STUDIO_TIME_ZONE=Asia/Seoul
STUDIO_HOST=127.0.0.1
PORT=8787
